# Copy to .env and change these before going live.

# Long random string, e.g. from: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
DB_PASSWORD=change-this-database-password

# Production (Contabo): the address Caddy gets an HTTPS certificate for. deploy/setup-server.sh fills these in.
DOMAIN=motors.porshi.tech
ACME_EMAIL=you@example.com
PUBLIC_URL=https://motors.porshi.tech

# Website port on this machine. 127.0.0.1 keeps it private; Caddy serves the public HTTPS site.
# For local testing without Caddy, open http://localhost:8080
WEB_BIND=127.0.0.1
WEB_PORT=8080

# DEMO_MODE=true shows portal login codes on screen (code 1234). Set false once SMS works.
DEMO_MODE=true
# SEED_ON_START=true loads the sample Kushtia data into an empty database. Set false for real use.
SEED_ON_START=true

# SMS: "console" only writes messages to the API log. "http" posts to a Bangladeshi SMS gateway
# (form fields: api_key, senderid, number, message). Adjust app/services.py send_sms() if your provider differs.
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=PORSHI
